{
  "name": "react-ui-kit",
  "version": "1.0.0",
  "description": "Reusable React authentication, loading, error, layout, and shared UI components.",
  "type": "module",
  "main": "dist/react-ui-kit.umd.js",
  "module": "dist/react-ui-kit.js",
  "exports": {
    ".": {
      "import": "./dist/react-ui-kit.js",
      "require": "./dist/react-ui-kit.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.lib.js",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "ui-kit",
    "login",
    "loading-screen",
    "auth-components",
    "layouts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
